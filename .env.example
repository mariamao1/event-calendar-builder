DATABASE_URL=sqlite:///.calendar-data/calendar.db
ADMIN_API_KEY=replace-with-a-long-random-value
# Private link token: anyone holding it can view and submit, no account
# needed. Generate one with `uv run calendar-api new-link-token`.
# When set, all public reads/submissions must present it as `?token=` or the
# X-Calendar-Token header. When unset, public routes stay open (local dev).
CALENDAR_ACCESS_TOKEN=replace-with-an-unguessable-link-token
# Real admin authentication: username plus a salted hash generated with
# `uv run calendar-api hash-password`. Admins log in at
# POST /api/v1/admin/login and use the issued bearer token.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-output-of-calendar-api-hash-password
ADMIN_SESSION_TTL_SECONDS=43200
# Abuse guards: submissions are open to link holders, so they are rate
# limited per client IP; logins are limited to slow credential guessing.
SUBMIT_RATE_LIMIT_MAX=30
SUBMIT_RATE_LIMIT_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
HOST=127.0.0.1
PORT=8000
MATERIALIZATION_PAST_DAYS=90
MATERIALIZATION_FUTURE_MONTHS=18
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MIGRATIONS_DIR=db/migrations
